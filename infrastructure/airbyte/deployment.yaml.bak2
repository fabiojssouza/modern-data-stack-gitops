apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: data-stack-infrastructure
  namespace: argocd
spec:
  project: data-stack
  source:
    repoURL: https://github.com/seu-usuario/modern-data-stack-gitops
    targetRevision: main
    path: infrastructure
  destination:
    server: https://kubernetes.default.svc
    namespace: data-stack
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
